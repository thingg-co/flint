#!/usr/bin/env bash
# Start Flint detached on the Spark. Run by deploy/spark/flint.service (a oneshot timer
# unit) and by hand. This file is the launcher's source of truth: install.sh copies it to
# ~/.local/bin/flint-start, and the FLINT_* environment for this box lives here.
#
#   follow logs:   journalctl --user -u flint-run -f
#   stop:          systemctl --user stop flint-run   (or: pkill -9 -f "python -m flint")
set -euo pipefail

cd "$HOME/Development/flint"
export PATH="$HOME/.local/bin:$PATH"

if ss -ltn | grep -q ':8000 '; then
    echo "Flint is already listening on :8000; not restarting (a restart resets the trusted count)."
    exit 0
fi
if [[ ! -x .venv/bin/python ]]; then
    echo "no .venv: run  uv sync  first" >&2
    exit 1
fi

# The Spark's environment. Every knob in flint/config.py can go here as FLINT_<NAME>.
ENV=(
    FLINT_HOST=0.0.0.0                                 # reachable from the LAN and the mobile app
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True   # one growable pool instead of per-shape blocks: training,
                                                       # validation and per-bar prediction do not each keep their own
    FLINT_COMPILE=1                                    # torch.compile the train step: 2.1x on the GB10
    FLINT_MAX_WARMUP_SECONDS=300                       # tune budget 5000 ms/step so the ladder reaches 5XL
                                                       # (~57 GB with the replay at 212 names); the bench runs
                                                       # eager, live steps run compiled at about half that
    FLINT_REPLAY_GB=30                                 # replay budget; the window count follows the universe
                                                       # (12,000 windows at 232 names, 7,000 at 400)
    FLINT_MAX_UNIVERSE=400                             # core + holdings + up to interesting_count promoted names
    FLINT_INTERESTING_COUNT=150
    FLINT_DEEP_BACKFILL_DAYS=200                       # page Schwab history back this far while the market is closed
                                                       # (~140 trading days: fills the replay without wrapping it)
    FLINT_BRIEF_BACKEND=openai                         # the brief, when enabled, talks to a LOCAL
    FLINT_BRIEF_OPENAI_BASE=http://127.0.0.1:8080/v1   # llama-server on :8080 -- never a cloud API
)

# "degraded" is a running manager with some unrelated failed unit (a crash notifier, say); only
# a manager that is not running at all sends us to the nohup fallback, which no `systemctl stop`
# can reach.
case "$(systemctl --user is-system-running 2>/dev/null)" in running|degraded) HAVE_SYSTEMD=1 ;; *) HAVE_SYSTEMD= ;; esac
if command -v systemd-run >/dev/null 2>&1 && [ -n "$HAVE_SYSTEMD" ]; then
    # A transient user unit of its own, so it outlives the oneshot timer service that calls us
    # and logs to the journal.
    systemd-run --user --unit=flint-run --collect --quiet \
        -p WorkingDirectory="$PWD" -p KillMode=mixed \
        env "${ENV[@]}" "$PWD/.venv/bin/python" -m flint
    echo "Flint starting as user unit flint-run (journalctl --user -u flint-run -f)"
else
    mkdir -p state
    nohup env "${ENV[@]}" "$PWD/.venv/bin/python" -m flint >> state/flint.log 2>&1 &
    echo "Flint starting, pid $!, log state/flint.log"
fi
